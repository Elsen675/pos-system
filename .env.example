# Bu faylı .env kimi köçürün və dəyərləri doldurun. .env git-ə düşmür.
# Açar yaratmaq üçün:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=buraya-uzun-tesadufi-acar

# --- Yerli inkişaf (öz kompüterinizdə) ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Server (məs. PythonAnywhere) üçün nümunə ---
